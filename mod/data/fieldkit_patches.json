        {
            "table": "Traits/D_Itemable.json",
            "_comment": "Feature scour.",
            "add": [
                {
                    "Name": "Item_Fieldkit_Scourer",
                    "DisplayName": "NSLOCTEXT(\"D_Itemable\", \"Item_Fieldkit_Scourer-DisplayName\", \"Sonic Scourer\")",
                    "Icon": "/Game/Assets/2DArt/UI/Items/Item_Icons/Deployables/T_ITEM_Sandworm_Thumper.T_ITEM_Sandworm_Thumper",
                    "Description": "NSLOCTEXT(\"D_Itemable\", \"Item_Fieldkit_Scourer-Description\", \"A terraforming-era ground thumper re-tuned for housekeeping. Every few minutes, while powered and loaded with the right cartridge, it fires a low sonic pulse that shakes snow, sand or ash off every building piece within range. Feed it Thermal Cartridges for snow, Cyclone Filters for sand and Scrubber Filters for ash; one cartridge serves about ten pieces per pulse. It waits for a storm to finish before it bothers. Connect it to power; press interact to load cartridges, hold to switch it on or off.\")",
                    "FlavorText": "NSLOCTEXT(\"D_Itemable\", \"Item_Fieldkit_Scourer-FlavorText\", \"The colonists called it the broom. The engineers pretended not to hear.\")",
                    "Weight": 25000,
                    "MaxStack": 1
                },
                {
                    "Name": "Item_Fieldkit_Cartridge_Snow",
                    "DisplayName": "NSLOCTEXT(\"D_Itemable\", \"Item_Fieldkit_Cartridge_Snow-DisplayName\", \"Thermal Cartridge\")",
                    "Icon": "/Game/Assets/2DArt/UI/Items/Item_Icons/Resources/ITEM_Electronics.ITEM_Electronics",
                    "Description": "NSLOCTEXT(\"D_Itemable\", \"Item_Fieldkit_Cartridge_Snow-Description\", \"A sealed heating element for the Sonic Scourer. Melts packed snow off roofs and walls so the pulse can shake the rest loose. One cartridge serves about ten building pieces.\")",
                    "FlavorText": "NSLOCTEXT(\"D_Itemable\", \"Item_Fieldkit_Cartridge_Snow-FlavorText\", \"Even on Icarus, nothing beats warmth for moving snow.\")",
                    "Weight": 500,
                    "MaxStack": 20
                },
                {
                    "Name": "Item_Fieldkit_Cartridge_Sand",
                    "DisplayName": "NSLOCTEXT(\"D_Itemable\", \"Item_Fieldkit_Cartridge_Sand-DisplayName\", \"Cyclone Filter\")",
                    "Icon": "/Game/Assets/2DArt/UI/Items/Item_Icons/Resources/ITEM_Composite.ITEM_Composite",
                    "Description": "NSLOCTEXT(\"D_Itemable\", \"Item_Fieldkit_Cartridge_Sand-Description\", \"A spun-fiber cyclone cartridge for the Sonic Scourer. Traps the sand the pulse lifts off building pieces instead of letting it settle back down. One filter serves about ten building pieces.\")",
                    "FlavorText": "NSLOCTEXT(\"D_Itemable\", \"Item_Fieldkit_Cartridge_Sand-FlavorText\", \"The desert gives its sand freely and takes it back the same way.\")",
                    "Weight": 500,
                    "MaxStack": 20
                },
                {
                    "Name": "Item_Fieldkit_Cartridge_Ash",
                    "DisplayName": "NSLOCTEXT(\"D_Itemable\", \"Item_Fieldkit_Cartridge_Ash-DisplayName\", \"Scrubber Filter\")",
                    "Icon": "/Game/Assets/2DArt/UI/Items/Item_Icons/Resources/ITEM_Charcoal.ITEM_Charcoal",
                    "Description": "NSLOCTEXT(\"D_Itemable\", \"Item_Fieldkit_Cartridge_Ash-Description\", \"A charcoal scrubber cartridge for the Sonic Scourer. Binds volcanic ash lifted by the pulse before it can cake onto the next surface. One filter serves about ten building pieces.\")",
                    "FlavorText": "NSLOCTEXT(\"D_Itemable\", \"Item_Fieldkit_Cartridge_Ash-FlavorText\", \"Ash is patient. So is a good filter.\")",
                    "Weight": 500,
                    "MaxStack": 20
                }
            ]
        },
