{
    "_comment": "Rows the Fieldkit pak adds: Custom World Settings switches (D_CustomGameStats rows rendered by that screen, each bound to a hidden world stat in D_Stats; the Lua reads the values from the ProspectSubsystem by row name) and, for the scour feature, its craftable Sonic Scourer and cartridges. Row names are prefixed Fieldkit_. build.py applies patches.json and this file to ONE table set and writes every touched table into both paks, so the two mods may add rows to the same tables (each pak then carries the other's rows for shared tables, which is harmless).",
    "tables": [
        {
            "table": "Stats/D_Stats.json",
            "_comment": "World stats the settings bind to. Hidden; the Lua never reads the stat, only the setting.",
            "add": [
                {
                    "Name": "Fieldkit_TameRegen_?",
                    "Title": "NSLOCTEXT(\"D_Stats\", \"Fieldkit_TameRegen_?-Title\", \"Tame Regeneration (Fieldkit)\")",
                    "PositiveTitleFormat": "INVTEXT(\"{0}\")",
                    "NegativeTitleFormat": "INVTEXT(\"{0}\")",
                    "PositiveDescription": "NSLOCTEXT(\"D_Stats\", \"Fieldkit_TameRegen_?-PositiveDescription\", \"Tames on Follow heal faster out of combat\")",
                    "bIsReplicated": true,
                    "bIsWorldStat": true,
                    "StatCategory": {
                        "RowName": "World"
                    },
                    "bHideStatInUserInterface": true
                },
                {
                    "Name": "Fieldkit_TameRegenRate_+",
                    "Title": "NSLOCTEXT(\"D_Stats\", \"Fieldkit_TameRegenRate_+-Title\", \"Tame Regeneration Rate (Fieldkit)\")",
                    "PositiveTitleFormat": "INVTEXT(\"{0}\")",
                    "NegativeTitleFormat": "INVTEXT(\"{0}\")",
                    "PositiveDescription": "NSLOCTEXT(\"D_Stats\", \"Fieldkit_TameRegenRate_+-PositiveDescription\", \"{0}% of maximum health per minute\")",
                    "bIsReplicated": true,
                    "bIsWorldStat": true,
                    "StatCategory": {
                        "RowName": "World"
                    },
                    "bHideStatInUserInterface": true
                },
                {
                    "Name": "Fieldkit_Stow_?",
                    "Title": "NSLOCTEXT(\"D_Stats\", \"Fieldkit_Stow_?-Title\", \"Stow (Fieldkit)\")",
                    "PositiveTitleFormat": "INVTEXT(\"{0}\")",
                    "NegativeTitleFormat": "INVTEXT(\"{0}\")",
                    "PositiveDescription": "NSLOCTEXT(\"D_Stats\", \"Fieldkit_Stow_?-PositiveDescription\", \"Put backpack items away into pinned chests with one key\")",
                    "bIsReplicated": true,
                    "bIsWorldStat": true,
                    "StatCategory": {
                        "RowName": "World"
                    },
                    "bHideStatInUserInterface": true
                },
                {
                    "Name": "Fieldkit_StowRange_+",
                    "Title": "NSLOCTEXT(\"D_Stats\", \"Fieldkit_StowRange_+-Title\", \"Stow Range (Fieldkit)\")",
                    "PositiveTitleFormat": "INVTEXT(\"{0}\")",
                    "NegativeTitleFormat": "INVTEXT(\"{0}\")",
                    "PositiveDescription": "NSLOCTEXT(\"D_Stats\", \"Fieldkit_StowRange_+-PositiveDescription\", \"{0} m\")",
                    "bIsReplicated": true,
                    "bIsWorldStat": true,
                    "StatCategory": {
                        "RowName": "World"
                    },
                    "bHideStatInUserInterface": true
                },
                {
                    "Name": "Fieldkit_StowLearn_?",
                    "Title": "NSLOCTEXT(\"D_Stats\", \"Fieldkit_StowLearn_?-Title\", \"Stow Learning (Fieldkit)\")",
                    "PositiveTitleFormat": "INVTEXT(\"{0}\")",
                    "NegativeTitleFormat": "INVTEXT(\"{0}\")",
                    "PositiveDescription": "NSLOCTEXT(\"D_Stats\", \"Fieldkit_StowLearn_?-PositiveDescription\", \"Opening a chest pins its contents\")",
                    "bIsReplicated": true,
                    "bIsWorldStat": true,
                    "StatCategory": {
                        "RowName": "World"
                    },
                    "bHideStatInUserInterface": true
                }
            ]
        },
        {
            "table": "Stats/D_CustomGameStats.json",
            "_comment": "Feature tameregen, Creatures section.",
            "add": [
                {
                    "Name": "Fieldkit_TameRegen",
                    "DisplayName": "NSLOCTEXT(\"D_CustomGameStats\", \"Fieldkit_TameRegen-DisplayName\", \"Fieldkit: Tame Regeneration\")",
                    "Description": "NSLOCTEXT(\"D_CustomGameStats\", \"Fieldkit_TameRegen-Description\", \"Tames set to Follow heal a share of their maximum health every second while out of combat, scaled by their Nurtured Recovery talent rank. Off leaves the game's normal regeneration.\")",
                    "Category": "Creatures",
                    "StatChangeability": "Anytime",
                    "StatType": "Bool",
                    "DefaultValue": 1,
                    "Stat": {
                        "RowName": "Fieldkit_TameRegen_?"
                    },
                    "MaxIntValue": 1
                },
                {
                    "Name": "Fieldkit_TameRegenRate",
                    "DisplayName": "NSLOCTEXT(\"D_CustomGameStats\", \"Fieldkit_TameRegenRate-DisplayName\", \"Fieldkit: Tame Regeneration Rate\")",
                    "Description": "NSLOCTEXT(\"D_CustomGameStats\", \"Fieldkit_TameRegenRate-Description\", \"Percent of maximum health healed per minute at Nurtured Recovery rank 4; lower ranks get a share. 15 is the default: a 2,200 HP mount is back to full in about 7 minutes.\")",
                    "Category": "Creatures",
                    "StatChangeability": "Anytime",
                    "StatType": "Int",
                    "DefaultValue": 15,
                    "Stat": {
                        "RowName": "Fieldkit_TameRegenRate_+"
                    },
                    "MinIntValue": 1,
                    "MaxIntValue": 60
                }
            ]
        },
        {
            "table": "Stats/D_CustomGameStats.json",
            "_comment": "Feature stow, Misc section. Same table as above: build.py merges the add lists.",
            "add": [
                {
                    "Name": "Fieldkit_Stow",
                    "DisplayName": "NSLOCTEXT(\"D_CustomGameStats\", \"Fieldkit_Stow-DisplayName\", \"Fieldkit: Stow\")",
                    "Description": "NSLOCTEXT(\"D_CustomGameStats\", \"Fieldkit_Stow-Description\", \"Pin chests to item types (open the chest, Shift+P or the Pin button) and press Shift+E to put every matching backpack stack into the pinned chests nearby. Off disables the deposit key; pins are kept.\")",
                    "Category": "Misc",
                    "StatChangeability": "Anytime",
                    "StatType": "Bool",
                    "DefaultValue": 1,
                    "Stat": {
                        "RowName": "Fieldkit_Stow_?"
                    },
                    "MaxIntValue": 1
                },
                {
                    "Name": "Fieldkit_StowRange",
                    "DisplayName": "NSLOCTEXT(\"D_CustomGameStats\", \"Fieldkit_StowRange-DisplayName\", \"Fieldkit: Stow Range\")",
                    "Description": "NSLOCTEXT(\"D_CustomGameStats\", \"Fieldkit_StowRange-Description\", \"How far from you a pinned chest may be for the deposit key to fill it, in metres.\")",
                    "Category": "Misc",
                    "StatChangeability": "Anytime",
                    "StatType": "Int",
                    "DefaultValue": 30,
                    "Stat": {
                        "RowName": "Fieldkit_StowRange_+"
                    },
                    "MinIntValue": 5,
                    "MaxIntValue": 100
                },
                {
                    "Name": "Fieldkit_StowLearn",
                    "DisplayName": "NSLOCTEXT(\"D_CustomGameStats\", \"Fieldkit_StowLearn-DisplayName\", \"Fieldkit: Stow Learning\")",
                    "Description": "NSLOCTEXT(\"D_CustomGameStats\", \"Fieldkit_StowLearn-Description\", \"Opening a chest adds whatever it holds to its pins, so chests you use normally keep attracting those items even after crafting emptied them. Off: only the pin key and button change pins.\")",
                    "Category": "Misc",
                    "StatChangeability": "Anytime",
                    "StatType": "Bool",
                    "DefaultValue": 1,
                    "Stat": {
                        "RowName": "Fieldkit_StowLearn_?"
                    },
                    "MaxIntValue": 1
                }
            ]
        },
