        },
        {
            "table": "Traits/D_Itemable.json",
            "add": [
                {
                    "Name": "Item_Massgate_Gate",
                    "DisplayName": "NSLOCTEXT(\"D_Itemable\", \"Item_Massgate_Gate-DisplayName\", \"Massgate Lattice (legacy, Anchor Alpha)\")",
                    "Icon": "/Game/Assets/2DArt/UI/Items/Item_Icons/Deployables/T_ITEM_Tesla_Coil.T_ITEM_Tesla_Coil",
                    "Description": "NSLOCTEXT(\"D_Itemable\", \"Item_Massgate_Gate-Description\", \"An early prototype lattice. Behaves as an Anchor on channel Alpha. Pick it up and place a current Anchor instead.\")",
                    "Weight": 40000,
