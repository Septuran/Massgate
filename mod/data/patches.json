        {
            "table": "Traits/D_Itemable.json",
            "add": [
                {
                    "Name": "Item_Massgate_Anchor",
                    "DisplayName": "NSLOCTEXT(\"D_Itemable\", \"Item_Massgate_Anchor-DisplayName\", \"Massgate Anchor Lattice\")",
                    "Icon": "/Game/Assets/2DArt/UI/Items/Item_Icons/Deployables/T_ITEM_Landing_Pad_OEI.T_ITEM_Landing_Pad_OEI",
                    "Description": "NSLOCTEXT(\"D_Itemable\", \"Item_Massgate_Anchor-Description\", \"The base end of a Massgate pair. A heavy lattice of stabilised exotic matter that bends space toward itself and pulls whatever stands in a tuned Resonator's field back to this pad. Anchors lock to the shared grid of the base, so any number of them can stand side by side. Needs heavy power. Tune the channel on the placed lattice. Outbound transits burn Exotics; inbound ones are carried by the anchor's own mass.\")",
                    "FlavorText": "NSLOCTEXT(\"D_Itemable\", \"Item_Massgate_Anchor-FlavorText\", \"Exotics do not move through space. Space moves around them. UDA Field Manual, addendum 7, classified.\")",
                    "Weight": 40000,
                    "MaxStack": 1
                },
                {
                    "Name": "Item_Massgate_Resonator",
                    "DisplayName": "NSLOCTEXT(\"D_Itemable\", \"Item_Massgate_Resonator-DisplayName\", \"Massgate Resonator\")",
                    "Icon": "/Game/Assets/2DArt/UI/Items/Item_Icons/Deployables/ITEM_Survey_Transmitter.ITEM_Survey_Transmitter",
                    "Description": "NSLOCTEXT(\"D_Itemable\", \"Item_Massgate_Resonator-Description\", \"The field end of a Massgate pair. A sliver of exotic lattice, just enough to phase-lock to one Anchor on the channel you tune it to. Light, modest on power, and unshielded: any other lattice within 500 m, Anchor or Resonator, pulls it off frequency and it refuses to tune. Place it far from everything and give it its own small power supply.\")",
                    "FlavorText": "NSLOCTEXT(\"D_Itemable\", \"Item_Massgate_Resonator-FlavorText\", \"A tuning fork does not sing on its own. It waits for the bell.\")",
                    "Weight": 15000,
                    "MaxStack": 1
                }
            ]
        },
