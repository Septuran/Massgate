                    "Requirement": { "RowName": "Massgate_Gate" },
                    "RequiredMillijoules": 300000,
                    "RecipeSets": [ { "RowName": "Fabricator", "DataTableName": "D_RecipeSets" } ],
                    "Inputs": [
                        { "Element": { "RowName": "MetaResource", "DataTableName": "D_ItemsStatic" }, "Count": 200 },
