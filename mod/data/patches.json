{
    "_comment": "Rows Massgate adds to the Icarus data tables. Applied by tools/build.py on top of the base tables. Row names are prefixed Massgate_ so they never collide with the game or other mods. Tables marked per_channel are expanded once per entry in channels, with {CH} replaced by the channel name. Row naming is Massgate_<Kind>_<Channel>, Kind = Anchor (base end) or Resonator (field end); the Lua side parses both back out of the item row name, so adding channels here is all it takes.",
    "channels": ["Alpha", "Beta", "Gamma"],
    "tables": [
        {
            "table": "Items/D_ItemsStatic.json",
            "per_channel": true,
            "add": [
                {
                    "Name": "Massgate_Anchor_{CH}",
                    "Meshable": { "RowName": "Mesh_Generic_Fabricator" },
                    "Itemable": { "RowName": "Item_Massgate_Anchor_{CH}" },
                    "Interactable": { "RowName": "Massgate_Gate" },
                    "Focusable": { "RowName": "Focusable_1H" },
                    "Highlightable": { "RowName": "Generic" },
                    "Actionable": { "RowName": "Deployable" },
                    "Usable": { "RowName": "Place" },
                    "Deployable": { "RowName": "Massgate_Anchor" },
                    "Durable": { "RowName": "Deployable_5000" },
                    "Decayable": { "RowName": "Decay_10_Minutes" },
                    "Weight": { "RowName": "HeavyDeployable" },
                    "Resource": { "RowName": "Massgate_Anchor" },
                    "Audio": { "RowName": "MetalDeployable" },
                    "CraftingExperience": 0,
                    "Generated_Tags": {
                        "GameplayTags": [
                            { "TagName": "Traits.Meshable" },
                            { "TagName": "Traits.Itemable" },
                            { "TagName": "Traits.Interactable" },
                            { "TagName": "Traits.Highlightable" },
                            { "TagName": "Traits.Actionable" },
                            { "TagName": "Traits.Usable" },
                            { "TagName": "Traits.Deployable" },
                            { "TagName": "Traits.Durable" }
                        ],
                        "ParentTags": []
                    }
                },
                {
                    "Name": "Massgate_Resonator_{CH}",
                    "Meshable": { "RowName": "Mesh_Generic_Fabricator" },
                    "Itemable": { "RowName": "Item_Massgate_Resonator_{CH}" },
                    "Interactable": { "RowName": "Massgate_Gate" },
                    "Focusable": { "RowName": "Focusable_1H" },
                    "Highlightable": { "RowName": "Generic" },
                    "Actionable": { "RowName": "Deployable" },
                    "Usable": { "RowName": "Place" },
                    "Deployable": { "RowName": "Massgate_Resonator" },
                    "Durable": { "RowName": "Deployable_2500" },
                    "Decayable": { "RowName": "Decay_10_Minutes" },
                    "Weight": { "RowName": "MediumDeployable" },
                    "Resource": { "RowName": "Massgate_Resonator" },
                    "Audio": { "RowName": "MetalDeployable" },
                    "CraftingExperience": 0,
                    "Generated_Tags": {
                        "GameplayTags": [
                            { "TagName": "Traits.Meshable" },
                            { "TagName": "Traits.Itemable" },
                            { "TagName": "Traits.Interactable" },
                            { "TagName": "Traits.Highlightable" },
                            { "TagName": "Traits.Actionable" },
                            { "TagName": "Traits.Usable" },
                            { "TagName": "Traits.Deployable" },
                            { "TagName": "Traits.Durable" }
                        ],
                        "ParentTags": []
                    }
                }
            ]
        },
        {
            "table": "Items/D_ItemTemplate.json",
            "per_channel": true,
            "add": [
                { "Name": "Massgate_Anchor_{CH}", "ItemStaticData": { "RowName": "Massgate_Anchor_{CH}" } },
                { "Name": "Massgate_Resonator_{CH}", "ItemStaticData": { "RowName": "Massgate_Resonator_{CH}" } }
            ]
        },
        {
            "table": "Traits/D_Itemable.json",
            "per_channel": true,
            "add": [
                {
                    "Name": "Item_Massgate_Anchor_{CH}",
                    "DisplayName": "NSLOCTEXT(\"D_Itemable\", \"Item_Massgate_Anchor_{CH}-DisplayName\", \"Massgate Anchor Lattice ({CH})\")",
                    "Icon": "/Game/Assets/2DArt/UI/Items/Item_Icons/Deployables/T_ITEM_Tesla_Coil.T_ITEM_Tesla_Coil",
                    "Description": "NSLOCTEXT(\"D_Itemable\", \"Item_Massgate_Anchor_{CH}-Description\", \"The base end of a Massgate pair on channel {CH}. A heavy lattice of stabilised exotic matter that bends space toward itself and pulls whatever stands in a tuned Resonator's field back to this pad. Anchors lock to the shared grid of the base, so any number of them can stand side by side. Needs heavy power. Outbound transits burn Exotics; inbound ones are carried by the anchor's own mass.\")",
                    "FlavorText": "NSLOCTEXT(\"D_Itemable\", \"Item_Massgate_Anchor_{CH}-FlavorText\", \"Exotics do not move through space. Space moves around them. UDA Field Manual, addendum 7, classified.\")",
                    "Weight": 40000,
                    "MaxStack": 1
                },
                {
                    "Name": "Item_Massgate_Resonator_{CH}",
                    "DisplayName": "NSLOCTEXT(\"D_Itemable\", \"Item_Massgate_Resonator_{CH}-DisplayName\", \"Massgate Resonator ({CH})\")",
                    "Icon": "/Game/Assets/2DArt/UI/Items/Item_Icons/Deployables/T_ITEM_Tesla_Coil.T_ITEM_Tesla_Coil",
                    "Description": "NSLOCTEXT(\"D_Itemable\", \"Item_Massgate_Resonator_{CH}-Description\", \"The field end of a Massgate pair on channel {CH}. A sliver of exotic lattice, just enough to phase-lock to one Anchor. Light, modest on power, and unshielded: any other lattice within 500 m, Anchor or Resonator, pulls it off frequency and it refuses to tune. Place it far from everything and give it its own small power supply.\")",
                    "FlavorText": "NSLOCTEXT(\"D_Itemable\", \"Item_Massgate_Resonator_{CH}-FlavorText\", \"A tuning fork does not sing on its own. It waits for the bell.\")",
                    "Weight": 15000,
                    "MaxStack": 1
                }
            ]
        },
        {
            "table": "Items/D_ItemsStatic.json",
            "_comment": "Legacy pre-channel row so gates placed with v0.1 keep loading. No recipe; Lua treats it as Anchor / Alpha.",
            "add": [
                {
                    "Name": "Massgate_Gate",
